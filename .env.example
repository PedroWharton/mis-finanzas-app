# Copiá este archivo a .env.local para desarrollo. En producción, cargá estas
# variables en Vercel (Settings → Environment Variables). Ver README.

# Clave para entrar a la app. Obligatoria en producción; vacía en local = sin clave.
APP_PASSWORD=

# La crea Vercel al conectar un Blob store privado. Vacía en local = datos en data/.
BLOB_READ_WRITE_TOKEN=
# Opcional: sufijo para separar los datos de otro entorno (ej. -preview).
BLOB_PATH_SUFFIX=

# Corrida diaria (vercel.json). Generar con: openssl rand -hex 32
CRON_SECRET=

# Token para Claude (carga por screenshot y rutinas). Generar con: openssl rand -hex 32
AGENTE_TOKEN=

# Notificaciones push (opcional). Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com
